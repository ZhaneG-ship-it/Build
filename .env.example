# Local development configuration.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me"
APP_URL="http://localhost:3000"

# Optional. With a key set, the platform runs its analysis through Claude.
# Without one it runs the deterministic in-process analysis engine instead,
# and the whole workflow still works end to end.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_ANALYSIS_MODEL="claude-opus-5"
ANTHROPIC_REPORT_MODEL="claude-opus-5"
FILE_STORAGE_DIR="./storage"
