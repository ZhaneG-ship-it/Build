{
  "name": "clarity-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Business Intelligence, Readiness Assessment and Implementation Management Platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test": "tsx --conditions=react-server --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@prisma/client": "^6.1.0",
    "mammoth": "^1.8.0",
    "next": "^15.1.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
